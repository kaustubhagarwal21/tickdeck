{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // TypeScript 6 no longer loads every installed @types package on its own,
    // so the Jest globals the tests use (describe, it, expect) are listed here.
    "types": ["jest"],
    // The shared package lives outside this app. The same mapping is in
    // metro.config.js (for the bundler) and jest.config.js (for the tests).
    "paths": {
      "@tickdeck/core": ["../packages/core/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist-web", ".expo"]
}
